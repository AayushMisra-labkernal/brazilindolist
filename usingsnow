-- ============================================================
-- STEP 0: PROJECT INFRASTRUCTURE SETUP
-- ============================================================
-- Snowflake environment: Warehouse, Database, Schemas, File Format

USE ROLE ACCOUNTADMIN;

-- 0.1: Virtual Warehouse (Compute Engine)
-- Queries run karne ke liye compute provide karega
CREATE WAREHOUSE IF NOT EXISTS OLIST_WH
WITH
    WAREHOUSE_SIZE = 'XSMALL'
    AUTO_SUSPEND = 60
    AUTO_RESUME = TRUE
    INITIALLY_SUSPENDED = TRUE;

-- 0.2: Database (Project Container)
CREATE DATABASE IF NOT EXISTS OLIST_ECOMMERCE;

-- 0.3: Schemas (Logical Layers)
-- RAW = As-is data from source (no transformation)
-- STAGING = Cleaned + standardized data
-- CORE = Star Schema (Facts + Dimensions)
-- ANALYTICS = Business-ready views/aggregations
CREATE SCHEMA IF NOT EXISTS OLIST_ECOMMERCE.RAW;
CREATE SCHEMA IF NOT EXISTS OLIST_ECOMMERCE.STAGING;
CREATE SCHEMA IF NOT EXISTS OLIST_ECOMMERCE.CORE;
CREATE SCHEMA IF NOT EXISTS OLIST_ECOMMERCE.ANALYTICS;

-- 0.4: File Format (CSV parsing rules for COPY INTO / Load Data wizard)
CREATE OR REPLACE FILE FORMAT OLIST_ECOMMERCE.RAW.CSV_FORMAT
    TYPE = CSV
    SKIP_HEADER = 1
    FIELD_OPTIONALLY_ENCLOSED_BY = '"'
    NULL_IF = ('', 'NULL', 'null')
    EMPTY_FIELD_AS_NULL = TRUE;

-- ============================================================
-- STEP 1: CREATE RAW TABLES (⚠️ WARNING: DO NOT RE-RUN AFTER DATA IS LOADED!)
-- ============================================================
-- RAW layer = exact copy of source data, no transformations
-- Data loaded via Snowsight "Load Data" wizard (direct CSV → Table)
-- ⚠️ CREATE OR REPLACE will DROP existing data! Only run once during initial setup.

USE WAREHOUSE OLIST_WH;
USE DATABASE OLIST_ECOMMERCE;
USE SCHEMA RAW;

-- 1.1: Customers (99,441 rows expected)
CREATE TABLE IF NOT EXISTS RAW_CUSTOMERS (
    customer_id STRING,
    customer_unique_id STRING,
    customer_zip_code_prefix STRING,
    customer_city STRING,
    customer_state STRING
);

-- 1.2: Orders (99,441 rows expected)
CREATE TABLE IF NOT EXISTS RAW_ORDERS (
    order_id STRING,
    customer_id STRING,
    order_status STRING,
    order_purchase_timestamp TIMESTAMP,
    order_approved_at TIMESTAMP,
    order_delivered_carrier_date TIMESTAMP,
    order_delivered_customer_date TIMESTAMP,
    order_estimated_delivery_date TIMESTAMP
);

-- 1.3: Order Items (112,650 rows expected)
CREATE TABLE IF NOT EXISTS RAW_ORDER_ITEMS (
    order_id STRING,
    order_item_id NUMBER,
    product_id STRING,
    seller_id STRING,
    shipping_limit_date TIMESTAMP,
    price NUMBER(10,2),
    freight_value NUMBER(10,2)
);

-- 1.4: Order Payments (103,886 rows expected)
CREATE TABLE IF NOT EXISTS RAW_ORDER_PAYMENTS (
    order_id STRING,
    payment_sequential NUMBER,
    payment_type STRING,
    payment_installments NUMBER,
    payment_value NUMBER(10,2)
);

-- 1.5: Order Reviews (99,224 rows expected)
CREATE TABLE IF NOT EXISTS RAW_ORDER_REVIEWS (
    review_id STRING,
    order_id STRING,
    review_score NUMBER,
    review_comment_title STRING,
    review_comment_message STRING,
    review_creation_date TIMESTAMP,
    review_answer_timestamp TIMESTAMP
);

-- 1.6: Products (32,951 rows expected)
CREATE TABLE IF NOT EXISTS RAW_PRODUCTS (
    product_id STRING,
    product_category_name STRING,
    product_name_length NUMBER,
    product_description_length NUMBER,
    product_photos_qty NUMBER,
    product_weight_g NUMBER,
    product_length_cm NUMBER,
    product_height_cm NUMBER,
    product_width_cm NUMBER
);

-- 1.7: Sellers (3,095 rows expected)
CREATE TABLE IF NOT EXISTS RAW_SELLERS (
    seller_id STRING,
    seller_zip_code_prefix STRING,
    seller_city STRING,
    seller_state STRING
);

-- 1.8: Geolocation (1,000,163 rows expected)
CREATE TABLE IF NOT EXISTS RAW_GEOLOCATION (
    geolocation_zip_code_prefix STRING,
    geolocation_lat NUMBER(10,6),
    geolocation_lng NUMBER(10,6),
    geolocation_city STRING,
    geolocation_state STRING
);

-- 1.9: Category Translation (71 rows expected)
CREATE TABLE IF NOT EXISTS RAW_CATEGORY_TRANSLATION (
    product_category_name STRING,
    product_category_name_english STRING
);

-- ============================================================
-- STEP 2: VERIFY DATA LOAD (run after loading via Snowsight UI)
-- ============================================================
-- Data loaded using: Snowsight → Table → Load Data button
-- Behind the scenes Snowflake uses COPY INTO with an auto-managed stage

SELECT 'RAW_CUSTOMERS' AS table_name, COUNT(*) AS row_count FROM RAW_CUSTOMERS
UNION ALL SELECT 'RAW_ORDERS', COUNT(*) FROM RAW_ORDERS
UNION ALL SELECT 'RAW_ORDER_ITEMS', COUNT(*) FROM RAW_ORDER_ITEMS
UNION ALL SELECT 'RAW_ORDER_PAYMENTS', COUNT(*) FROM RAW_ORDER_PAYMENTS
UNION ALL SELECT 'RAW_ORDER_REVIEWS', COUNT(*) FROM RAW_ORDER_REVIEWS
UNION ALL SELECT 'RAW_PRODUCTS', COUNT(*) FROM RAW_PRODUCTS
UNION ALL SELECT 'RAW_SELLERS', COUNT(*) FROM RAW_SELLERS
UNION ALL SELECT 'RAW_GEOLOCATION', COUNT(*) FROM RAW_GEOLOCATION
UNION ALL SELECT 'RAW_CATEGORY_TRANSLATION', COUNT(*) FROM RAW_CATEGORY_TRANSLATION
ORDER BY table_name;

-- ============================================================
-- STEP 3: STAGING LAYER (Cleaned & Standardized)
-- ============================================================
-- Purpose: Handle nulls, standardize types, add English category names
-- Convention: STG_ prefix, same grain as RAW

USE SCHEMA OLIST_ECOMMERCE.STAGING;

-- 3.1: Staged Customers
CREATE OR REPLACE TABLE STG_CUSTOMERS AS
SELECT
    customer_id,
    customer_unique_id,
    customer_zip_code_prefix,
    INITCAP(TRIM(customer_city)) AS customer_city,
    UPPER(TRIM(customer_state)) AS customer_state
FROM OLIST_ECOMMERCE.RAW.RAW_CUSTOMERS
WHERE customer_id IS NOT NULL;

-- 3.2: Staged Orders
CREATE OR REPLACE TABLE STG_ORDERS AS
SELECT
    order_id,
    customer_id,
    LOWER(TRIM(order_status)) AS order_status,
    order_purchase_timestamp,
    order_approved_at,
    order_delivered_carrier_date,
    order_delivered_customer_date,
    order_estimated_delivery_date,
    DATEDIFF('day', order_purchase_timestamp, order_delivered_customer_date) AS delivery_days_actual,
    DATEDIFF('day', order_purchase_timestamp, order_estimated_delivery_date) AS delivery_days_estimated
FROM OLIST_ECOMMERCE.RAW.RAW_ORDERS
WHERE order_id IS NOT NULL;

-- 3.3: Staged Order Items
CREATE OR REPLACE TABLE STG_ORDER_ITEMS AS
SELECT
    order_id,
    order_item_id,
    product_id,
    seller_id,
    shipping_limit_date,
    price,
    freight_value,
    price + freight_value AS total_item_value
FROM OLIST_ECOMMERCE.RAW.RAW_ORDER_ITEMS
WHERE order_id IS NOT NULL;

-- 3.4: Staged Payments
CREATE OR REPLACE TABLE STG_PAYMENTS AS
SELECT
    order_id,
    payment_sequential,
    LOWER(TRIM(payment_type)) AS payment_type,
    payment_installments,
    payment_value
FROM OLIST_ECOMMERCE.RAW.RAW_ORDER_PAYMENTS
WHERE order_id IS NOT NULL;

-- 3.5: Staged Reviews
CREATE OR REPLACE TABLE STG_REVIEWS AS
SELECT
    review_id,
    order_id,
    review_score,
    TRIM(review_comment_title) AS review_comment_title,
    TRIM(review_comment_message) AS review_comment_message,
    review_creation_date,
    review_answer_timestamp,
    DATEDIFF('day', review_creation_date, review_answer_timestamp) AS response_days
FROM OLIST_ECOMMERCE.RAW.RAW_ORDER_REVIEWS
WHERE order_id IS NOT NULL;

-- 3.6: Staged Products (with English category name)
CREATE OR REPLACE TABLE STG_PRODUCTS AS
SELECT
    p.product_id,
    p.product_category_name AS category_name_pt,
    COALESCE(t.product_category_name_english, p.product_category_name) AS category_name_en,
    p.product_name_length,
    p.product_description_length,
    p.product_photos_qty,
    p.product_weight_g,
    p.product_length_cm,
    p.product_height_cm,
    p.product_width_cm,
    (p.product_length_cm * p.product_height_cm * p.product_width_cm) AS volume_cm3
FROM OLIST_ECOMMERCE.RAW.RAW_PRODUCTS p
LEFT JOIN OLIST_ECOMMERCE.RAW.RAW_CATEGORY_TRANSLATION t
    ON p.product_category_name = t.product_category_name;

-- 3.7: Staged Sellers
CREATE OR REPLACE TABLE STG_SELLERS AS
SELECT
    seller_id,
    seller_zip_code_prefix,
    INITCAP(TRIM(seller_city)) AS seller_city,
    UPPER(TRIM(seller_state)) AS seller_state
FROM OLIST_ECOMMERCE.RAW.RAW_SELLERS
WHERE seller_id IS NOT NULL;

-- ============================================================
-- STEP 4: CORE LAYER (Star Schema)
-- ============================================================
-- Purpose: Business-modeled data in dimensional format
-- Fact table at order-item grain, dimensions for lookup

USE SCHEMA OLIST_ECOMMERCE.CORE;

-- 4.1: DIM_CUSTOMERS (SCD Type 1 - latest state)
CREATE OR REPLACE TABLE DIM_CUSTOMERS AS
SELECT
    customer_unique_id AS customer_key,
    MAX(customer_id) AS customer_id,
    MAX(customer_city) AS city,
    MAX(customer_state) AS state,
    MAX(customer_zip_code_prefix) AS zip_code_prefix
FROM OLIST_ECOMMERCE.STAGING.STG_CUSTOMERS
GROUP BY customer_unique_id;

-- 4.2: DIM_PRODUCTS
CREATE OR REPLACE TABLE DIM_PRODUCTS AS
SELECT
    product_id AS product_key,
    category_name_en AS category,
    product_weight_g AS weight_g,
    volume_cm3,
    product_photos_qty AS photos_count,
    product_description_length AS description_length
FROM OLIST_ECOMMERCE.STAGING.STG_PRODUCTS;

-- 4.3: DIM_SELLERS
CREATE OR REPLACE TABLE DIM_SELLERS AS
SELECT
    seller_id AS seller_key,
    seller_city AS city,
    seller_state AS state,
    seller_zip_code_prefix AS zip_code_prefix
FROM OLIST_ECOMMERCE.STAGING.STG_SELLERS;

-- 4.4: DIM_DATE (generated calendar)
CREATE OR REPLACE TABLE DIM_DATE AS
SELECT
    d.date_val AS date_key,
    YEAR(d.date_val) AS year,
    QUARTER(d.date_val) AS quarter,
    MONTH(d.date_val) AS month,
    MONTHNAME(d.date_val) AS month_name,
    DAYOFWEEK(d.date_val) AS day_of_week,
    DAYNAME(d.date_val) AS day_name,
    WEEKOFYEAR(d.date_val) AS week_of_year,
    CASE WHEN DAYOFWEEK(d.date_val) IN (0, 6) THEN TRUE ELSE FALSE END AS is_weekend
FROM (
    SELECT DATEADD(day, SEQ4(), '2016-01-01')::DATE AS date_val
    FROM TABLE(GENERATOR(ROWCOUNT => 1096))
) d;

-- 4.5: FACT_ORDER_ITEMS (grain = one row per order item)
CREATE OR REPLACE TABLE FACT_ORDER_ITEMS AS
SELECT
    oi.order_id,
    oi.order_item_id,
    o.customer_id,
    c.customer_key,
    oi.product_id AS product_key,
    oi.seller_id AS seller_key,
    o.order_purchase_timestamp::DATE AS order_date_key,
    o.order_status,
    oi.price,
    oi.freight_value,
    oi.total_item_value,
    o.delivery_days_actual,
    o.delivery_days_estimated,
    r.review_score,
    p.payment_type AS primary_payment_type
FROM OLIST_ECOMMERCE.STAGING.STG_ORDER_ITEMS oi
JOIN OLIST_ECOMMERCE.STAGING.STG_ORDERS o ON oi.order_id = o.order_id
LEFT JOIN OLIST_ECOMMERCE.STAGING.STG_CUSTOMERS sc ON o.customer_id = sc.customer_id
LEFT JOIN DIM_CUSTOMERS c ON sc.customer_unique_id = c.customer_key
LEFT JOIN OLIST_ECOMMERCE.STAGING.STG_REVIEWS r ON o.order_id = r.order_id
LEFT JOIN (
    SELECT order_id, payment_type
    FROM OLIST_ECOMMERCE.STAGING.STG_PAYMENTS
    QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY payment_sequential) = 1
) p ON o.order_id = p.order_id;

-- ============================================================
-- STEP 5: ANALYTICS LAYER (Business Views)
-- ============================================================
-- Purpose: Ready-to-consume aggregations for dashboards & reporting

USE SCHEMA OLIST_ECOMMERCE.ANALYTICS;

-- 5.1: Monthly Revenue Summary
CREATE OR REPLACE VIEW V_MONTHLY_REVENUE AS
SELECT
    DATE_TRUNC('month', order_date_key) AS revenue_month,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(price) AS total_revenue,
    SUM(freight_value) AS total_freight,
    SUM(total_item_value) AS total_gmv,
    ROUND(AVG(total_item_value), 2) AS avg_order_item_value
FROM OLIST_ECOMMERCE.CORE.FACT_ORDER_ITEMS
WHERE order_status = 'delivered'
GROUP BY 1
ORDER BY 1;

-- 5.2: Category Performance
CREATE OR REPLACE VIEW V_CATEGORY_PERFORMANCE AS
SELECT
    dp.category,
    COUNT(DISTINCT f.order_id) AS total_orders,
    SUM(f.price) AS total_revenue,
    ROUND(AVG(f.review_score), 2) AS avg_review_score,
    ROUND(AVG(f.delivery_days_actual), 1) AS avg_delivery_days
FROM OLIST_ECOMMERCE.CORE.FACT_ORDER_ITEMS f
JOIN OLIST_ECOMMERCE.CORE.DIM_PRODUCTS dp ON f.product_key = dp.product_key
WHERE f.order_status = 'delivered'
GROUP BY 1
ORDER BY total_revenue DESC;

-- 5.3: Seller Scorecard
CREATE OR REPLACE VIEW V_SELLER_SCORECARD AS
SELECT
    ds.seller_key,
    ds.city AS seller_city,
    ds.state AS seller_state,
    COUNT(DISTINCT f.order_id) AS orders_fulfilled,
    SUM(f.price) AS total_revenue,
    ROUND(AVG(f.review_score), 2) AS avg_review_score,
    ROUND(AVG(f.delivery_days_actual), 1) AS avg_delivery_days
FROM OLIST_ECOMMERCE.CORE.FACT_ORDER_ITEMS f
JOIN OLIST_ECOMMERCE.CORE.DIM_SELLERS ds ON f.seller_key = ds.seller_key
WHERE f.order_status = 'delivered'
GROUP BY 1, 2, 3
ORDER BY total_revenue DESC;

-- 5.4: Customer Lifetime Value (CLV)
CREATE OR REPLACE VIEW V_CUSTOMER_CLV AS
SELECT
    c.customer_key,
    c.city,
    c.state,
    COUNT(DISTINCT f.order_id) AS total_orders,
    SUM(f.total_item_value) AS lifetime_value,
    ROUND(AVG(f.review_score), 2) AS avg_review_score,
    MIN(f.order_date_key) AS first_order_date,
    MAX(f.order_date_key) AS last_order_date
FROM OLIST_ECOMMERCE.CORE.FACT_ORDER_ITEMS f
JOIN OLIST_ECOMMERCE.CORE.DIM_CUSTOMERS c ON f.customer_key = c.customer_key
WHERE f.order_status = 'delivered'
GROUP BY 1, 2, 3;

-- 5.5: Delivery Performance Analysis
CREATE OR REPLACE VIEW V_DELIVERY_PERFORMANCE AS
SELECT
    DATE_TRUNC('month', order_date_key) AS order_month,
    COUNT(DISTINCT order_id) AS total_orders,
    ROUND(AVG(delivery_days_actual), 1) AS avg_delivery_days,
    ROUND(AVG(delivery_days_estimated), 1) AS avg_estimated_days,
    SUM(CASE WHEN delivery_days_actual > delivery_days_estimated THEN 1 ELSE 0 END) AS late_deliveries,
    ROUND(SUM(CASE WHEN delivery_days_actual > delivery_days_estimated THEN 1 ELSE 0 END) * 100.0 
        / NULLIF(COUNT(*), 0), 1) AS late_delivery_pct
FROM OLIST_ECOMMERCE.CORE.FACT_ORDER_ITEMS
WHERE order_status = 'delivered' AND delivery_days_actual IS NOT NULL
GROUP BY 1
ORDER BY 1;

-- 5.6: Payment Method Analysis
CREATE OR REPLACE VIEW V_PAYMENT_ANALYSIS AS
SELECT
    primary_payment_type AS payment_type,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(total_item_value) AS total_gmv,
    ROUND(AVG(total_item_value), 2) AS avg_order_value,
    ROUND(AVG(review_score), 2) AS avg_review_score
FROM OLIST_ECOMMERCE.CORE.FACT_ORDER_ITEMS
WHERE order_status = 'delivered'
GROUP BY 1
ORDER BY total_gmv DESC;

